<resources>

    <style name="Theme.Base" parent="Theme.Material3.DynamicColors.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:navigationBarColor">@color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <!-- 换装第 2 步：跟壁纸走的颜色属性，默认 = 原样（深色壁纸/不叠壁纸的页面不变） -->
        <item name="museToneLight">false</item>
        <item name="museToneText">@color/white</item>
        <item name="museToneTextSub">@color/muse_tone_white_sub</item>
        <item name="museItemText">@color/selector_text</item>
        <item name="museShapeItem">@drawable/shape_item</item>
        <item name="museShapeItemRound">@drawable/shape_item_round</item>
        <item name="museShapeTypeChip">@drawable/shape_type_chip</item>
    </style>

    <!-- 浅色壁纸（羊皮纸 1/2 号、亮的自定义壁纸）：墨褐正文、次要 #8A735C、选中赤陶；灰条改卡片色+细描边 -->
    <style name="ThemeOverlay.Muse.Light" parent="">
        <item name="museToneLight">true</item>
        <item name="museToneText">@color/muse_tone_ink</item>
        <item name="museToneTextSub">@color/muse_tone_sub</item>
        <item name="museItemText">@color/selector_text_light</item>
        <item name="museShapeItem">@drawable/shape_item_light</item>
        <item name="museShapeItemRound">@drawable/shape_item_round_light</item>
        <item name="museShapeTypeChip">@drawable/shape_type_chip_light</item>
    </style>

    <!-- 弹窗/浮层恢复原配色（弹窗自带不透明底，不跟壁纸走） -->
    <style name="ThemeOverlay.Muse.Reset" parent="">
        <item name="museToneLight">false</item>
        <item name="museToneText">@color/white</item>
        <item name="museToneTextSub">@color/muse_tone_white_sub</item>
        <item name="museItemText">@color/selector_text</item>
        <item name="museShapeItem">@drawable/shape_item</item>
        <item name="museShapeItemRound">@drawable/shape_item_round</item>
        <item name="museShapeTypeChip">@drawable/shape_type_chip</item>
    </style>

    <!-- 壁纸页顶栏：菜单文字（如「导入书籍」）、溢出/返回图标跟壁纸深浅走 -->
    <style name="ThemeOverlay.Muse.Toolbar" parent="">
        <item name="actionMenuTextColor">?attr/museToneText</item>
        <item name="android:actionMenuTextColor">?attr/museToneText</item>
        <item name="colorControlNormal">?attr/museToneText</item>
    </style>

    <style name="Theme.Splash" parent="Theme.SplashScreen">
        <item name="postSplashScreenTheme">@style/Theme.App</item>
        <item name="windowSplashScreenBackground">@color/muse_parchment</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>

    <style name="Theme.App" parent="Theme.Base" />

    <style name="Theme.Crash" parent="Theme.Base">
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowBackground">@color/grey_700</item>
    </style>

    <style name="Control">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:textColor">@color/yellow</item>
        <item name="android:textSize">14sp</item>
        <item name="android:padding">8dp</item>
    </style>

    <style name="ToolbarTextAppearance" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">?attr/museToneText</item>
        <item name="titleTextColor">?attr/museToneText</item>
    </style>


    <!-- 日志面板横滑行里的胶囊：宽度按字（不再均分截字）。 -->
    <style name="LogPanelChip" parent="LogPanelButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_weight">0</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>

    <style name="LogPanelButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">3dp</item>
        <item name="android:layout_marginEnd">3dp</item>
        <item name="android:background">@drawable/selector_log_capsule</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:paddingStart">2dp</item>
        <item name="android:paddingTop">7dp</item>
        <item name="android:paddingEnd">2dp</item>
        <item name="android:paddingBottom">7dp</item>
        <item name="android:textColor">#333333</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- 本地源弹窗主题（照搬 VesperTV）：解除 windowFixedWidthMajor/Minor 的钳制，否则 setWidth factor 不生效；
         注意必须用 AppCompat 命名空间写这两个属性，android: 命名空间下 AAPT2 会报私有属性错。 -->
    <style name="TaixuAlertDialogTheme" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="windowFixedWidthMajor">0dp</item>
        <item name="windowFixedWidthMinor">0dp</item>
    </style>
</resources>


