<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/hh_bg_card"
    android:orientation="vertical"
    android:paddingStart="@dimen/hh_space_5"
    android:paddingTop="@dimen/hh_space_5"
    android:paddingEnd="@dimen/hh_space_5"
    android:paddingBottom="@dimen/hh_space_6">

    <com.google.android.material.textview.MaterialTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/hh_space_3"
        android:text="@string/search_scope_title"
        android:textColor="@color/hh_text_primary"
        android:textSize="@dimen/hh_text_t1"
        android:textStyle="bold" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/scopeCurrent"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/hh_space_2"
        android:gravity="start|center_vertical"
        android:minHeight="@dimen/hh_touch"
        android:minWidth="@dimen/hh_touch"
        android:paddingStart="@dimen/hh_space_3"
        android:paddingTop="@dimen/hh_space_2"
        android:paddingEnd="@dimen/hh_space_3"
        android:paddingBottom="@dimen/hh_space_2"
        android:text="@string/search_scope_current"
        android:textAllCaps="false"
        android:textColor="@color/hh_text_accent"
        android:textSize="@dimen/hh_text_t2"
        app:backgroundTint="@color/hh_neutral_soft_bg"
        app:strokeColor="@color/hh_stroke_hairline" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/scopeAll"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/hh_space_2"
        android:gravity="start|center_vertical"
        android:minHeight="@dimen/hh_touch"
        android:minWidth="@dimen/hh_touch"
        android:paddingStart="@dimen/hh_space_3"
        android:paddingTop="@dimen/hh_space_2"
        android:paddingEnd="@dimen/hh_space_3"
        android:paddingBottom="@dimen/hh_space_2"
        android:text="@string/search_scope_all"
        android:textAllCaps="false"
        android:textColor="@color/hh_text_accent"
        android:textSize="@dimen/hh_text_t2"
        app:backgroundTint="@color/hh_neutral_soft_bg"
        app:strokeColor="@color/hh_stroke_hairline" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/groupTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/hh_space_1"
        android:layout_marginBottom="@dimen/hh_space_2"
        android:text="@string/search_scope_group"
        android:textColor="@color/hh_text_primary"
        android:textSize="@dimen/hh_text_t2" />

    <HorizontalScrollView
        android:id="@+id/groupScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/hh_space_2"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:scrollbars="none">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/groupList"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

    </HorizontalScrollView>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/typeTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/hh_space_1"
        android:layout_marginBottom="@dimen/hh_space_2"
        android:text="@string/search_scope_type"
        android:textColor="@color/hh_text_primary"
        android:textSize="@dimen/hh_text_t2" />

    <HorizontalScrollView
        android:id="@+id/typeScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:scrollbars="none">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/typeList"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

    </HorizontalScrollView>

</androidx.appcompat.widget.LinearLayoutCompat>
