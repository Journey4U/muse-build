<?xml version="1.0" encoding="utf-8"?>
<!-- 转存页：复用 dialog_source_transfer.xml 的载体（列表定高 284dp、底部提示 maxLines=3、输入框主题色），
     底部操作栏是 Activity 自己的：选择源文件（仅无源文件时可见）、新建文件夹、保存到这里、取消。
     不另起一套转存布局，避免两套 id 漂移。 -->
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include
        android:id="@+id/transferPanel"
        layout="@layout/dialog_source_transfer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/transferPick"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/transfer_open_save_to"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/transferCreateDir"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/transfer_new_dir" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/transferSave"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/transfer_save_here" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/transferCancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/transfer_cancel" />

    </androidx.appcompat.widget.LinearLayoutCompat>

</androidx.appcompat.widget.LinearLayoutCompat>
