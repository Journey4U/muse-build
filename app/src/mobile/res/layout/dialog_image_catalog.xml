<?xml version="1.0" encoding="utf-8"?>
<!--
  图片目录弹窗（#63）：几何与小说目录 dialog_novel_catalog 逐项同构——
  分页头（上一页 / 页码信息 / 下一页）+ 自适应胶囊网格，列数（1..4）与每页话数由
  ImageActivity.applyCatalogMetrics() 按面板可用宽高动态计算并写入 catalogGrid 的 columnCount；
  catalogScroll 的 240dp 只是打开前兜底高度，运行时由代码按屏高 55% 覆盖；窗口宽 = 屏宽 × 0.95。
  皮肤换图片页的深色语言：面板底 = hh_scrim 同色系的近不透明深灰（窗口底已设透明，面板自成一体），
  胶囊统一 bg_image_pill（当前话 selected 暖金高亮），文字全白、页码信息白 70%。
  与小说目录的两处外形差异（都因深色而起）：① 标题「目录」做进布局（系统弹窗标题栏是浅色主题会露白边）；
  ② 「取消」做进布局底部（同理不用 builder 的按钮栏）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/catalogRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#F2141719"
    android:orientation="vertical"
    android:paddingStart="@dimen/hh_space_3"
    android:paddingTop="@dimen/hh_space_2"
    android:paddingEnd="@dimen/hh_space_3"
    android:paddingBottom="@dimen/hh_space_2">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:text="目录"
        android:textColor="@android:color/white"
        android:textSize="@dimen/hh_text_t1"
        android:textStyle="bold" />

    <!-- 分页控制：上一页 / 页码信息 / 下一页（与小说目录同构） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/hh_space_2"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/catalogPrev"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_image_pill"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="@dimen/hh_space_4"
            android:paddingTop="@dimen/hh_space_2"
            android:paddingEnd="@dimen/hh_space_4"
            android:paddingBottom="@dimen/hh_space_2"
            android:singleLine="true"
            android:text="上一页"
            android:textColor="@android:color/white"
            android:textSize="@dimen/hh_text_t2" />

        <TextView
            android:id="@+id/catalogPageInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:singleLine="true"
            android:text="第 1-100 话 / 共 0 话"
            android:textColor="#B3FFFFFF"
            android:textSize="@dimen/hh_text_t5" />

        <TextView
            android:id="@+id/catalogNext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_image_pill"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="@dimen/hh_space_4"
            android:paddingTop="@dimen/hh_space_2"
            android:paddingEnd="@dimen/hh_space_4"
            android:paddingBottom="@dimen/hh_space_2"
            android:singleLine="true"
            android:text="下一页"
            android:textColor="@android:color/white"
            android:textSize="@dimen/hh_text_t2" />

    </LinearLayout>

    <!-- 自适应话网格，列数与每页话数由代码按面板尺寸计算后填充（240dp 由代码覆盖） -->
    <ScrollView
        android:id="@+id/catalogScroll"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:layout_marginTop="@dimen/hh_space_2"
        android:scrollbarStyle="outsideOverlay">

        <GridLayout
            android:id="@+id/catalogGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3" />

    </ScrollView>

    <!-- 取消：布局内胶囊（替代 builder 按钮栏，避免浅色按钮条压深色面板） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/hh_space_2"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/catalogCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_image_pill"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="@dimen/hh_space_4"
            android:paddingTop="@dimen/hh_space_2"
            android:paddingEnd="@dimen/hh_space_4"
            android:paddingBottom="@dimen/hh_space_2"
            android:singleLine="true"
            android:text="取消"
            android:textColor="@android:color/white"
            android:textSize="@dimen/hh_text_t2" />

    </LinearLayout>

</LinearLayout>
