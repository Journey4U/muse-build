<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/hh_bg_card"
    android:orientation="vertical"
    android:paddingStart="@dimen/hh_space_2"
    android:paddingTop="@dimen/hh_space_3"
    android:paddingEnd="@dimen/hh_space_2"
    android:paddingBottom="@dimen/hh_space_2">

    <!-- 顶部关键词行：左右外框放大（padding 收窄），图标间距紧凑，把宽度让给输入框 -->
    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="@dimen/hh_space_2" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/keyword"
            android:layout_width="0dp"
            android:layout_height="@dimen/hh_touch"
            android:layout_weight="1"
            android:background="@drawable/bg_hh_pill"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"
            android:hint="@string/site_search_hint"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:maxLength="255"
            android:paddingStart="@dimen/hh_space_3"
            android:paddingEnd="@dimen/hh_space_3"
            android:singleLine="true"
            android:textColor="@color/hh_text_primary"
            android:textColorHint="@color/hh_text_hint"
            android:textSize="@dimen/hh_text_t2"
            app:drawableStartCompat="@drawable/ic_site_search"
            app:drawableTint="@color/hh_accent" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/block"
            android:layout_width="@dimen/hh_icon_lg"
            android:layout_height="@dimen/hh_touch"
            android:layout_marginStart="@dimen/hh_space_3"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="0dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_site_hidden"
            app:tint="@color/hh_accent" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/search"
            android:layout_width="@dimen/hh_icon_lg"
            android:layout_height="@dimen/hh_touch"
            android:layout_marginStart="@dimen/hh_space_3"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="0dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_site_single_column"
            app:tint="@color/hh_accent" />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <HorizontalScrollView
        android:id="@+id/groupScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/hh_space_1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:visibility="gone">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/groupList"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

    </HorizontalScrollView>

    <!-- 源列表：与关键词行间距紧凑（8dp），最大限度提升每行可用宽度 -->
    <com.muse.android.tv.ui.custom.CustomRecyclerView
        android:id="@+id/recycler"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/hh_space_1"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingTop="0dp"
        android:paddingBottom="0dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:maxHeight="480dp" />

<!-- r35-⑤：勾选（多选）操作栏 —— 长按源名进入勾选模式后才显示 -->
    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/selectBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/hh_space_2"
        android:background="@drawable/bg_hh_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/hh_space_3"
        android:paddingTop="@dimen/hh_space_2"
        android:paddingEnd="@dimen/hh_space_3"
        android:paddingBottom="@dimen/hh_space_2"
        android:visibility="gone">

        <TextView
            android:id="@+id/selectCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/site_select_hint"
            android:textColor="@color/hh_text_primary"
            android:textSize="@dimen/hh_text_t5" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/selectAll"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:paddingStart="@dimen/hh_space_2"
            android:paddingEnd="@dimen/hh_space_2"
            android:text="@string/site_select_all"
            android:textColor="@color/hh_text_accent"
            android:textSize="@dimen/hh_text_t5" />

        <TextView
            android:id="@+id/selectInvert"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:paddingStart="@dimen/hh_space_2"
            android:paddingEnd="@dimen/hh_space_2"
            android:text="@string/site_select_invert"
            android:textColor="@color/hh_text_accent"
            android:textSize="@dimen/hh_text_t5" />

        <TextView
            android:id="@+id/selectNone"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:paddingStart="@dimen/hh_space_2"
            android:paddingEnd="@dimen/hh_space_2"
            android:text="@string/site_select_none"
            android:textColor="@color/hh_text_accent"
            android:textSize="@dimen/hh_text_t5" />

        <TextView
            android:id="@+id/selectCancel"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:paddingStart="@dimen/hh_space_2"
            android:paddingEnd="@dimen/hh_space_2"
            android:text="@string/dialog_negative"
            android:textColor="@color/hh_text_secondary"
            android:textSize="@dimen/hh_text_t5" />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <TextView
        android:id="@+id/selectConfirm"
        android:layout_width="match_parent"
        android:layout_height="@dimen/hh_touch"
        android:layout_marginTop="@dimen/hh_space_2"
        android:layout_marginStart="@dimen/hh_space_2"
        android:layout_marginEnd="@dimen/hh_space_2"
        android:background="@drawable/bg_hh_pill"
        android:gravity="center"
        android:text="@string/site_select_confirm"
        android:textColor="@color/hh_on_accent"
        android:textSize="@dimen/hh_text_t3"
        android:visibility="gone" />

</androidx.appcompat.widget.LinearLayoutCompat>
