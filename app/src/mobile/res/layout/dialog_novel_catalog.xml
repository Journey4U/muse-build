<?xml version="1.0" encoding="utf-8"?>
<!--
  章节目录弹窗：自适应网格 + 分页切换。
  列数（1..4）与每页章数由 NovelReaderActivity.applyCatalogMetrics() 按面板可用宽高动态计算并写入
  catalogGrid 的 columnCount；高度由 showCatalog() 按屏幕比例设置（catalogScroll）。
  下面 grid 的 columnCount 仅为布局预览默认值，运行时会被代码覆盖。
  #60 胶囊化：每个章节项由代码统一挂 bg_hh_pill 胶囊底（当前章 selected 暖金高亮），
  文案为「序号. 名称」（名称为纯数字时只显示该数字）；分页头上一页/下一页同挂胶囊底与之统一。
  r44 令牌化：弹窗壳（底色/内边距/翻页按钮/页码信息）改用 hh_* 令牌；
  蓝→暖金：翻页按钮文字为 hh_text_accent（浅色模式走 values 里的深金 #8A5F12，保证 5.2:1）。
  注意：catalogScroll 的 240dp 只是打开前的兜底高度，运行时由代码按屏高 55% 覆盖。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/catalogRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/hh_bg_card"
    android:orientation="vertical"
    android:paddingStart="@dimen/hh_space_3"
    android:paddingTop="@dimen/hh_space_2"
    android:paddingEnd="@dimen/hh_space_3"
    android:paddingBottom="@dimen/hh_space_2">

    <!-- 分页控制：上一页 / 页码信息 / 下一页 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/catalogPrev"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hh_pill"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="@dimen/hh_space_4"
            android:paddingTop="@dimen/hh_space_2"
            android:paddingEnd="@dimen/hh_space_4"
            android:paddingBottom="@dimen/hh_space_2"
            android:singleLine="true"
            android:text="上一页"
            android:textColor="@color/hh_text_accent"
            android:textSize="@dimen/hh_text_t2" />

        <TextView
            android:id="@+id/catalogPageInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:singleLine="true"
            android:text="第 1-100 章 / 共 0 章"
            android:textColor="@color/hh_text_secondary"
            android:textSize="@dimen/hh_text_t5" />

        <TextView
            android:id="@+id/catalogNext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hh_pill"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="@dimen/hh_space_4"
            android:paddingTop="@dimen/hh_space_2"
            android:paddingEnd="@dimen/hh_space_4"
            android:paddingBottom="@dimen/hh_space_2"
            android:singleLine="true"
            android:text="下一页"
            android:textColor="@color/hh_text_accent"
            android:textSize="@dimen/hh_text_t2" />

    </LinearLayout>

    <!-- 自适应章节网格，列数与每页章数由代码按面板尺寸计算后填充（240dp 由代码覆盖） -->
    <ScrollView
        android:id="@+id/catalogScroll"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:layout_marginTop="@dimen/hh_space_2"
        android:scrollbarStyle="outsideOverlay">

        <GridLayout
            android:id="@+id/catalogGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3" />

    </ScrollView>

</LinearLayout>
