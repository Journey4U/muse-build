<?xml version="1.0" encoding="utf-8"?>
<!-- 主题 2 护眼绿：由 shape_item_round_light_activated 换绿色板 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/muse_green_card" />
    <corners android:radius="20dp" />
    <padding
        android:bottom="6dp"
        android:left="12dp"
        android:right="12dp"
        android:top="6dp" />
    <stroke
        android:width="1dp"
        android:color="@color/muse_tone_accent" />
</shape>
