<resources>

    <style name="Theme.Base" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/white</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="android:windowAnimationStyle">@style/NoAnim</item>
        <!-- 换装第 2 步：跟壁纸走的颜色/焦点框属性，默认 = 原样（深色壁纸、播放器/直播等不叠壁纸的页面不变） -->
        <item name="museToneLight">false</item>
        <item name="museToneText">@color/white</item>
        <item name="museToneTextSub">@color/muse_tone_white_sub</item>
        <item name="museItemText">@color/text</item>
        <item name="museToneSite">@color/green_a_400</item>
        <item name="museToneRemark">@color/yellow_500</item>
        <item name="museSelItem">@drawable/selector_item</item>
        <item name="museSelItemRound">@drawable/selector_item_round</item>
        <item name="museSelButton">@drawable/selector_button</item>
        <item name="museSelKeyboard">@drawable/selector_keyboard</item>
        <item name="museSelVod">@drawable/selector_vod</item>
        <item name="museSelVodOval">@drawable/selector_vod_oval</item>
        <item name="museSelVideo">@drawable/selector_video</item>
        <item name="museShapeVodList">@drawable/shape_vod_list</item>
    </style>

    <!-- 浅色壁纸（羊皮纸 1/2 号、亮的自定义壁纸）：墨褐正文、选中赤陶、卡片色+细描边、焦点框赤陶 3dp -->
    <style name="ThemeOverlay.Muse.Light" parent="">
        <item name="museToneLight">true</item>
        <item name="museToneText">@color/muse_tone_ink</item>
        <item name="museToneTextSub">@color/muse_tone_sub</item>
        <item name="museItemText">@color/text_light</item>
        <item name="museToneSite">@color/muse_tone_site</item>
        <item name="museToneRemark">@color/muse_tone_accent</item>
        <item name="museSelItem">@drawable/selector_item_light</item>
        <item name="museSelItemRound">@drawable/selector_item_round_light</item>
        <item name="museSelButton">@drawable/selector_button_light</item>
        <item name="museSelKeyboard">@drawable/selector_keyboard_light</item>
        <item name="museSelVod">@drawable/selector_vod_light</item>
        <item name="museSelVodOval">@drawable/selector_vod_oval_light</item>
        <item name="museSelVideo">@drawable/selector_video_light</item>
        <item name="museShapeVodList">@drawable/shape_vod_list_light</item>
    </style>

    <!-- 弹窗/浮层恢复原配色（弹窗自带不透明底，不跟壁纸走） -->
    <style name="ThemeOverlay.Muse.Reset" parent="">
        <item name="museToneLight">false</item>
        <item name="museToneText">@color/white</item>
        <item name="museToneTextSub">@color/muse_tone_white_sub</item>
        <item name="museItemText">@color/text</item>
        <item name="museToneSite">@color/green_a_400</item>
        <item name="museToneRemark">@color/yellow_500</item>
        <item name="museSelItem">@drawable/selector_item</item>
        <item name="museSelItemRound">@drawable/selector_item_round</item>
        <item name="museSelButton">@drawable/selector_button</item>
        <item name="museSelKeyboard">@drawable/selector_keyboard</item>
        <item name="museSelVod">@drawable/selector_vod</item>
        <item name="museSelVodOval">@drawable/selector_vod_oval</item>
        <item name="museSelVideo">@drawable/selector_video</item>
        <item name="museShapeVodList">@drawable/shape_vod_list</item>
    </style>

    <style name="Theme.Splash" parent="Theme.SplashScreen">
        <item name="postSplashScreenTheme">@style/Theme.App</item>
        <item name="windowSplashScreenBackground">@color/muse_parchment</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>

    <style name="Theme.App" parent="Theme.Base" />

    <style name="Theme.Crash" parent="Theme.Base">
        <item name="android:windowBackground">@color/grey_800</item>
        <item name="android:windowDisablePreview">true</item>
    </style>

    <style name="NoAnim">
        <item name="android:activityOpenEnterAnimation">@null</item>
        <item name="android:activityOpenExitAnimation">@null</item>
        <item name="android:activityCloseEnterAnimation">@null</item>
        <item name="android:activityCloseExitAnimation">@null</item>
    </style>

    <style name="Shadow">
        <item name="android:shadowColor">#B0000000</item>
        <item name="android:shadowDx">1.5</item>
        <item name="android:shadowDy">1.5</item>
        <item name="android:shadowRadius">2</item>
    </style>

    <style name="Control">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/selector_chip</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:nextFocusUp">@id/exo_progress</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- 与手机版同名同义的弹窗主题（解除 windowFixedWidth 钳制），供电视版本地源/源操作弹窗使用。 -->
    <style name="TaixuAlertDialogTheme" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="windowFixedWidthMajor">0dp</item>
        <item name="windowFixedWidthMinor">0dp</item>
    </style>
</resources>
