{
  "manifest_version": 2,
  "name": "MuseSpike",
  "version": "1.0",
  "description": "Spike 0: webRequest blocking test for GeckoView migration",
  "browser_specific_settings": {
    "gecko": {
      "id": "muse-spike@example.com"
    }
  },
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "<all_urls>",
    "cookies",
    "nativeMessaging",
    "nativeMessagingFromContent",
    "geckoViewAddons"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content-isolated.js"
      ],
      "run_at": "document_start"
    }
  ]
}
